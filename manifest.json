{
  "manifest_version": 3,
  "name": "Extractor Multimedia",
  "version": "1.2.0",
  "description": "Galería temporal de imágenes, videos, embeds y enlaces de un tema del foro.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://perutops.com/*",
    "https://forosperu.club/*",
    "https://www.perutops.com/*",
    "https://www.forosperu.club/*"
  ],
  "action": {
    "default_title": "Extraer multimedia",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://perutops.com/*",
        "https://forosperu.club/*",
        "https://www.perutops.com/*",
        "https://www.forosperu.club/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
