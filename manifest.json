{
  "manifest_version": 3,
  "name": "Ext-Media",
  "version": "1.3.0",
  "description": "Extrae y organiza multimedia de temas de PeruTops en una galería local.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://perutops.com/*",
    "https://www.perutops.com/*"
  ],
  "action": {
    "default_title": "Extraer multimedia",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://perutops.com/*",
        "https://www.perutops.com/*"
      ],
      "js": [
        "shared/thread-identity.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
