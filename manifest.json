{
  "manifest_version": 3,
  "name": "Ext-Media",
  "version": "1.5.1",
  "description": "Extensión local para extraer y organizar multimedia de temas de PeruTops.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://perutops.com/*",
    "https://www.perutops.com/*"
  ],
  "action": {
    "default_title": "Extraer multimedia",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://perutops.com/*",
        "https://www.perutops.com/*"
      ],
      "js": [
        "shared/thread-identity.js",
        "shared/perutops-parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
