{
  "manifest_version": 3,
  "name": "Ext-Media",
  "version": "1.8.2",
  "description": "Extensión local para extraer y organizar multimedia de temas.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "assets/logo.png",
    "32": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png"
  },
  "host_permissions": [
    "https://perutops.com/*",
    "https://www.perutops.com/*",
    "https://media.perutops.com/*"
  ],
  "action": {
    "default_title": "Extraer multimedia",
    "default_icon": {
      "16": "assets/logo.png",
      "32": "assets/logo.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://perutops.com/*",
        "https://www.perutops.com/*"
      ],
      "js": [
        "shared/thread-identity.js",
        "shared/perutops-parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
